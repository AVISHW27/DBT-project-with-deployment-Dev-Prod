      "link": null,
      "locked": false,
      "text": "SELECT TOP (1000) [order_id]\n      ,[customer_id]\n      ,[order_date]\n      ,[sales]\n  FROM [MyDatabase].[dbo].[orders]\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "boYIuKmc6D3r2w0UXxurF",
      "originalText": "SELECT TOP (1000) [order_id]\n      ,[customer_id]\n      ,[order_date]\n      ,[sales]\n  FROM [MyDatabase].[dbo].[orders]\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "e2FKEJHp0EpEiV_KK6ct1",
      "type": "text",
      "x": 298.18881225585943,
      "y": 240.96827249678347,
      "width": 690.1238606770833,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
