      "created": 1790855866643,
      "link": null,
      "locked": false,
      "text": "Group all records with country name\nthen add grouped country score.\nNote : Each country record will be only one",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Group all records with country name\nthen add grouped country score.\nNote : Each country record will be only one",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "cx5HQWz9D6DHmGgtUdoHA",
      "type": "text",
      "x": 777.7919534683201,
      "y": 1081.7331390380862,
      "width": 558.0286342800306,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 801031754,
      "version": 907,
      "versionNonce": 1970802674,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790872167540,
      "created": 1790856416257,
      "link": null,
      "locked": false,
      "text": "Always give alias name to aggregate column \notherwise you will not get any column name in result",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Always give alias name to aggregate column \notherwise you will not get any column name in result",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "10v_K0LstD4ke2x7fgF67",
      "type": "text",
      "x": 775.3031427292598,
      "y": 1143.5045391264414,
      "width": 781.679443359375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 742275402,
      "version": 1148,
      "versionNonce": 1591385198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790872182876,
      "created": 1790856667264,
      "link": null,
      "locked": false,
      "text": "Note : Non-aggregate column name(like : country) must be define after group by clause\notherwise you will get error\nbecause, group by tells I need only columns which you want to group by and aggregate ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note : Non-aggregate column name(like : country) must be define after group by clause otherwise you will get error\nbecause, group by tells I need only columns which you want to group by and aggregate ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
