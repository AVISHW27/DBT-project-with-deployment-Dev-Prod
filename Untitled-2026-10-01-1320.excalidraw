      "seed": 1484606086,
      "version": 1149,
      "versionNonce": 26043206,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791566347495,
      "created": 1791538343134,
      "link": null,
      "locked": false,
      "text": "Note: Databricks automatically converts the uploaded CSV files into \"Managed Delta\nformat\" tables, generating six core tables: dim_customer, dim_date, dim_product,\ndim_store, fact_returns, and fact_sales",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "uwnmQoCGNNVk_9y_H7QUN",
      "originalText": "Note: Databricks automatically converts the uploaded CSV files into \"Managed Delta format\" tables, generating six core tables: dim_customer, dim_date, dim_product, dim_store, fact_returns, and fact_sales",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gUjNv1_ejSSIogeD3R9sA",
      "type": "rectangle",
      "x": 9497.80012948172,
      "y": -195.89846147809658,
      "width": 1131.2000732421877,
      "height": 255,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
