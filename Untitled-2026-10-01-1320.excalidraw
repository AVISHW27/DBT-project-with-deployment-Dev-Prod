    {
      "id": "jHD9tt2-ZpdpRQMheRc43",
      "type": "text",
      "x": -115.40009344191708,
      "y": 2134.506451924642,
      "width": 800,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 1636758958,
      "version": 4,
      "versionNonce": 483237486,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790873802162,
      "created": 1790873783799,
      "link": null,
      "locked": false,
      "text": "/* Find the average score for each country\n   and return only those countries with an average score greater\nthan 430 */\n\nSELECT\n    country,\n    AVG(score) AS avg_score\nFROM customers\nGROUP BY country\nHAVING AVG(score) > 430",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/* Find the average score for each country\n   and return only those countries with an average score greater than 430 */\n\nSELECT\n    country,\n    AVG(score) AS avg_score\nFROM customers\nGROUP BY country\nHAVING AVG(score) > 430",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UUtxaGWyU-1kBRetx6a82",
      "type": "text",
      "x": -139.40003240676083,
      "y": 2508.9064153035483,
      "width": 800,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 500803822,
      "version": 4,
      "versionNonce": 1099025710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790873806870,
      "created": 1790873793779,
      "link": null,
      "locked": false,
      "text": "/* Find the average score for each country\n   considering only customers with a score not equal to 0\n   and return only those countries with an average score greater\nthan 430 */\n\nSELECT\n    country,\n    AVG(score) AS avg_score\nFROM customers\nWHERE score != 0\nGROUP BY country\nHAVING AVG(score) > 430",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/* Find the average score for each country\n   considering only customers with a score not equal to 0\n   and return only those countries with an average score greater than 430 */\n\nSELECT\n    country,\n    AVG(score) AS avg_score\nFROM customers\nWHERE score != 0\nGROUP BY country\nHAVING AVG(score) > 430",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
