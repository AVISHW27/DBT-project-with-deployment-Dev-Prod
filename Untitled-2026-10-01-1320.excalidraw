    {
      "id": "74b2Y-9JUtE_zOIrq2AP1",
      "type": "text",
      "x": 9507.600056239533,
      "y": -327.19847978864345,
      "width": 1068.5911865234375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1V",
