      "updated": 1791566347495,
      "created": 1791538246135,
      "link": null,
      "locked": false,
      "text": "Open Databricks free edition\n                             create catalog : \"dbt_development\"\n                                  -> create new schema \"source\"\n                                  -> upload all files as table from git \nhttps://github.com/anshlambagit/AnshLambaYoutube/tree/main/DBT_Masterclass",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "5BTpPcZfyamCz4O5f-47j",
      "originalText": "Open Databricks free edition\n                             create catalog : \"dbt_development\"\n                                  -> create new schema \"source\"\n                                  -> upload all files as table from git \nhttps://github.com/anshlambagit/AnshLambaYoutube/tree/main/DBT_Masterclass",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
