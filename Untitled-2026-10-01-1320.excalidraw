      "text": "Before uv, we were using requirements.txt",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before uv, we were using requirements.txt",
