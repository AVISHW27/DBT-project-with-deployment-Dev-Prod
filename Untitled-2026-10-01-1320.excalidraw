      "isDeleted": false,
      "boundElements": [],
      "updated": 1791566347495,
      "created": 1791534549064,
      "link": null,
      "locked": false,
      "text": "But, now we have \"pyproject.toml\" which holds\nall the  dependencies.\nYou dont need to manage requirements.txt, if\nyou still want you can manage by using command\n\"uv pip freeze > requirements.txt",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But, now we have \"pyproject.toml\" which holds all the  dependencies.\nYou dont need to manage requirements.txt, if you still want you can manage by using command\n\"uv pip freeze > requirements.txt",
      "autoResize": false,
